<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.ECS.Generators.Consumer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Test-fixture component structs are data carriers, not public value-object contracts. -->
    <NoWarn>$(NoWarn);CA1051;CA1062;CA1724;CA1815;CS0649;IDE0005;IDE0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeltaECS\DeltaECS.csproj" />
    <ProjectReference Include="..\..\src\DeltaECS.Generators\DeltaECS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
