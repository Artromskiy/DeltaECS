<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Delta.ECS.Generators.Consumer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InterceptorsNamespaces>Delta.ECS.Generated</InterceptorsNamespaces>
    <!-- Test-fixture component structs are data carriers, not public value-object contracts. -->
    <NoWarn>$(NoWarn);CA1062;CA1724;CS0649;IDE0005;IDE0055</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="InterceptorsNamespaces" />
    <ProjectReference Include="..\..\src\DeltaECS\DeltaECS.csproj" />
    <ProjectReference Include="..\..\src\DeltaECS.Generators\DeltaECS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier" />
  </ItemGroup>
</Project>
