.ecs-inspector-root {
    flex-grow: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
}

.ecs-bound-inspector .ecs-inspector-root {
    flex-grow: 0;
}

.ecs-bound-inspector .ecs-component-list {
    flex-grow: 0;
    max-height: 480px;
}

.ecs-inspector-header,
.ecs-inspector-footer {
    flex-shrink: 0;
    padding-left: 5px;
    padding-right: 5px;
}

.ecs-inspector-header {
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

.ecs-inspector-footer {
    padding-bottom: 8px;
}

.ecs-component-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
}

.ecs-component-row {
    width: 100%;
    min-width: 0;
    flex-direction: row;
    align-items: stretch;
    margin: 0;
    padding: 0;
}

.ecs-component-list .unity-list-view__reorderable-handle {
    width: 22px;
    min-width: 22px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    background-color: var(--unity-colors-inspector_titlebar-background);
}

.ecs-component-list .unity-list-view__reorderable-item__container {
    margin: 0;
    padding: 0;
    flex-grow: 1;
}

.ecs-component-list .unity-list-view__item,
.ecs-component-list .unity-list-view__item:hover,
.ecs-component-list .unity-list-view__item:selected {
    background-color: transparent;
    border-width: 0;
    margin: 0;
}

.ecs-component-list .unity-list-view__reorderable-item,
.ecs-component-list .unity-list-view__reorderable-item:hover,
.ecs-component-list .unity-list-view__reorderable-item:selected {
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-inspector_titlebar-border_accent);
}

.ecs-component-list .ecs-add-component-row,
.ecs-component-list .ecs-add-component-row:hover,
.ecs-component-list .ecs-add-component-row:selected {
    border-bottom-width: 0;
}

.ecs-component-list .ecs-component-last-bound-row,
.ecs-component-list .ecs-component-last-bound-row:hover,
.ecs-component-list .ecs-component-last-bound-row:selected {
    border-bottom-width: 0;
}

.ecs-component-list .unity-list-view__reorderable-handle:hover {
    background-color: var(--unity-colors-inspector_titlebar-background-hover);
}

.ecs-add-component-row > .unity-list-view__reorderable-handle {
    display: none;
}

.ecs-entity-header {
    margin-bottom: 4px;
}

.ecs-entity-title-row,
.ecs-entity-id-row {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.ecs-entity-icon {
    width: 18px;
    height: 18px;
    margin-right: 4px;
    color: var(--unity-colors-label-text);
    -unity-text-align: middle-center;
}

.ecs-entity-name,
.ecs-runtime-entity-name {
    flex-grow: 1;
    min-width: 0;
    -unity-font-style: bold;
}

.ecs-entity-id-row {
    margin-top: 4px;
}

.ecs-view-binding {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.ecs-view-binding > .ecs-value-field {
    flex-grow: 1;
    min-width: 0;
}

.ecs-view-binding > .unity-button {
    margin-left: 4px;
}

.ecs-entity-metadata {
    flex-grow: 1;
    min-width: 0;
    color: var(--unity-colors-label-text);
    white-space: normal;
}

.ecs-runtime-id,
.ecs-schema-label,
.ecs-empty-component,
.ecs-unsupported-field {
    margin-top: 4px;
    color: rgb(174, 177, 183);
}

.ecs-component-card {
    width: auto;
    min-width: 0;
    flex-grow: 1;
    margin: 0;
    padding: 0;
    background-color: var(--unity-colors-window-background);
}

.ecs-component-card-header {
    width: 100%;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    align-items: center;
    margin: 0;
    padding-top: 0;
    padding-left: 5px;
    padding-bottom: 0;
    padding-right: 5px;
    background-color: var(--unity-colors-inspector_titlebar-background);
}

.ecs-component-card-header:hover {
    background-color: var(--unity-colors-inspector_titlebar-background-hover);
}

.ecs-component-title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.ecs-component-body {
    padding-top: 2px;
    padding-bottom: 4px;
}

.ecs-value-field > .unity-base-field__label {
    min-width: 96px;
    flex-basis: 36%;
    flex-shrink: 0;
    margin-right: 4px;
}

.ecs-value-field > .unity-base-field__input {
    min-width: 0;
    flex-grow: 1;
}

.ecs-component-menu,
.ecs-component-remove {
    width: 18px;
    min-width: 18px;
    max-width: 18px;
    height: 18px;
    min-height: 18px;
    max-height: 18px;
    flex-shrink: 0;
    align-self: center;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
    color: var(--unity-colors-label-text);
    background-color: transparent;
    border-width: 0;
    border-radius: 0;
}

.ecs-component-menu:hover,
.ecs-component-remove:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.ecs-component-menu:active,
.ecs-component-remove:active {
    background-color: var(--unity-colors-button-background-pressed);
}

.ecs-component-menu {
    align-items: center;
    justify-content: center;
    margin-right: 2px;
    color: var(--unity-colors-label-text);
    font-size: 13px;
}

.ecs-component-menu > .unity-toolbar-menu__text {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.ecs-component-menu-arrow {
    display: none;
}

.ecs-component-menu .unity-toolbar-menu__arrow {
    display: none;
}

.ecs-component-remove {
    font-size: 14px;
}

.ecs-add-component {
    width: 230px;
    height: 24px;
    align-self: center;
    margin-top: 5px;
    margin-bottom: 4px;
}

.ecs-delete-entity {
    margin-top: 2px;
}
