<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace>Delta.ECS.Systems</RootNamespace>
    <AssemblyName>DeltaECS.Systems</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>DeltaECS.Systems</PackageId>
    <Version>0.0.62</Version>
    <Authors>Artromskiy</Authors>
    <Description>Deterministic and parallel scheduler for DeltaECS systems.</Description>
    <PackageTags>ecs;entity-component-system;scheduler;parallel;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaECS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaECS\DeltaECS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\packages\DeltaECS.Systems.README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\API-SELECTION.md"
          Pack="true"
          PackagePath="docs/API-SELECTION.md"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\API-GRAMMAR.md"
          Pack="true"
          PackagePath="docs/API-GRAMMAR.md"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\..\docs\API-EXAMPLES.md"
          Pack="true"
          PackagePath="docs/API-EXAMPLES.md"
          Visible="false" />
  </ItemGroup>

</Project>
