<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DeltaECS.Profiling.Runtime/DeltaECS.Profiling.Runtime.csproj" />
    <PackageReference Include="Metalama.Framework" Version="2026.1.25" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/DeltaECS/DeltaECS.csproj"
                      Condition="'$(EnableEcsProfiling)' != 'true'" />
    <ProjectReference Include="../DeltaECS.Profiled/DeltaECS.Profiled.csproj"
                      Condition="'$(EnableEcsProfiling)' == 'true'" />
    <ProjectReference Include="../../src/DeltaECS.Generators/DeltaECS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
