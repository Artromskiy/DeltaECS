<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishAot>true</PublishAot>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InterceptorsNamespaces>Delta.ECS.Generated</InterceptorsNamespaces>
    <!-- The analyzer reference below removes this deployment property for the build-time generator. -->
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="InterceptorsNamespaces" />
    <ProjectReference Include="../../src/DeltaECS/DeltaECS.csproj" />
    <ProjectReference Include="../../src/DeltaECS.Generators/DeltaECS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier"
                      PrivateAssets="all" />
  </ItemGroup>

</Project>
