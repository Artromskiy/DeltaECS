<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaselineRoot Condition="'$(BaselineRoot)' == ''">/workspace/scratch/deltaecs-mainline</BaselineRoot>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</CandidateRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DeltaECS.VersionBenchmarks/adapters/Baseline/DeltaECS.VersionAdapter.Baseline.csproj" Aliases="baselineAdapter" AdditionalProperties="BaselineRoot=$(BaselineRoot);IncludeIterationScenario=false" />
    <ProjectReference Include="../DeltaECS.VersionBenchmarks/adapters/Candidate/DeltaECS.VersionAdapter.Candidate.csproj" Aliases="candidateAdapter" AdditionalProperties="CandidateRoot=$(CandidateRoot);IncludeIterationScenario=false" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
