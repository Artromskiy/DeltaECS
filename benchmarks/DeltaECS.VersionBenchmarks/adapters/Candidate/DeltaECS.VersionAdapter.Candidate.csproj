<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>DeltaECS.VersionAdapter.Candidate</AssemblyName>
    <RootNamespace>DeltaECS.VersionAdapter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Target Name="ValidateCandidateRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CandidateRoot)' == ''" Text="CandidateRoot is required." />
  </Target>

  <ItemGroup>
    <Compile Include="../../Shared/VersionScenarioTypes.cs" Link="VersionScenarioTypes.cs" />
    <Compile Include="IterationScenario.cs" />
    <ProjectReference Include="$(CandidateRoot)/src/DeltaECS/DeltaECS.csproj"
                      AdditionalProperties="AssemblyName=DeltaECS.Candidate" />
  </ItemGroup>

</Project>
