<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DeltaECS.VersionBenchmarks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</CandidateRoot>
  </PropertyGroup>

  <Target Name="ValidateVersionRoots" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(BaselineRoot)' == ''" Text="BaselineRoot is required. Pass -p:BaselineRoot=/path/to/baseline/checkout." />
    <Error Condition="!Exists('$(BaselineRoot)/src/DeltaECS/DeltaECS.csproj')" Text="BaselineRoot does not contain src/DeltaECS/DeltaECS.csproj: $(BaselineRoot)" />
    <Error Condition="!Exists('$(CandidateRoot)/src/DeltaECS/DeltaECS.csproj')" Text="CandidateRoot does not contain src/DeltaECS/DeltaECS.csproj: $(CandidateRoot)" />
  </Target>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="VersionBenchmarks.cs" />
    <ProjectReference Include="adapters/Baseline/DeltaECS.VersionAdapter.Baseline.csproj"
                      Aliases="baselineAdapter"
                      AdditionalProperties="BaselineRoot=$(BaselineRoot)" />
    <ProjectReference Include="adapters/Candidate/DeltaECS.VersionAdapter.Candidate.csproj"
                      Aliases="candidateAdapter"
                      AdditionalProperties="CandidateRoot=$(CandidateRoot)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DeltaECS.BaselineRoot" Value="$(BaselineRoot)" />
    <AssemblyMetadata Include="DeltaECS.CandidateRoot" Value="$(CandidateRoot)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>

</Project>
