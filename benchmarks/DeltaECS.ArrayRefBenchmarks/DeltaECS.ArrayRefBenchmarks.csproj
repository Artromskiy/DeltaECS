<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <RootNamespace>Delta.ECS.ArrayRefBenchmarks</RootNamespace>
    <AssemblyName>DeltaECS.ArrayRefBenchmarks</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <InterceptorsNamespaces>Delta.ECS.Generated</InterceptorsNamespaces>
    <!-- These assemblies are copied for Mono despite equivalent netstandard2.1 APIs. -->
    <!-- Generated public interception helpers do not carry consumer-facing XML documentation. -->
    <NoWarn>$(NoWarn);NU1510;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="InterceptorsNamespaces" />
    <ProjectReference Include="../../src/DeltaECS/DeltaECS.csproj" />
    <ProjectReference Include="../../src/DeltaECS.Generators/DeltaECS.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;SelfContained;RuntimeIdentifier"
                      PrivateAssets="all" />
    <PackageReference Include="BenchmarkDotNet" Version="0.13.12" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4"
                      GeneratePathProperty="true"
                      Condition="'$(TargetFramework)' == 'netstandard2.1'" />
    <PackageReference Include="System.Memory" Version="4.5.4"
                      GeneratePathProperty="true"
                      Condition="'$(TargetFramework)' == 'netstandard2.1'" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <None Include="$(PkgSystem_Threading_Tasks_Extensions)/lib/netstandard2.0/System.Threading.Tasks.Extensions.dll"
          Link="System.Threading.Tasks.Extensions.dll"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgSystem_Memory)/lib/netstandard2.0/System.Memory.dll"
          Link="System.Memory.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
