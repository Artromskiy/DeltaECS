<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DeltaECS.ProfileBenchmarks</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CandidateRoot Condition="'$(CandidateRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</CandidateRoot>
    <ProfileRuntimeFramework Condition="'$(ProfileRuntimeFramework)' == ''">net10.0</ProfileRuntimeFramework>
  </PropertyGroup>
  <Target Name="ValidateVersionRoots" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(BaselineRoot)/src/DeltaECS/DeltaECS.csproj')" Text="BaselineRoot invalid: $(BaselineRoot)" />
    <Error Condition="!Exists('$(CandidateRoot)/src/DeltaECS/DeltaECS.csproj')" Text="CandidateRoot invalid: $(CandidateRoot)" />
  </Target>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ProfileBenchmarks.cs" />
    <ProjectReference Include="adapters/Baseline/DeltaECS.ProfileAdapter.Baseline.csproj" Aliases="baselineAdapter" AdditionalProperties="BaselineRoot=$(BaselineRoot);ProfileRuntimeFramework=$(ProfileRuntimeFramework)" />
    <ProjectReference Include="adapters/Candidate/DeltaECS.ProfileAdapter.Candidate.csproj" Aliases="candidateAdapter" AdditionalProperties="CandidateRoot=$(CandidateRoot);ProfileRuntimeFramework=$(ProfileRuntimeFramework)" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DeltaECS.BaselineRoot" Value="$(BaselineRoot)" />
    <AssemblyMetadata Include="DeltaECS.CandidateRoot" Value="$(CandidateRoot)" />
    <AssemblyMetadata Include="DeltaECS.ProfileRuntimeFramework" Value="$(ProfileRuntimeFramework)" />
  </ItemGroup>
</Project>
